@using Vintellitour_Framework.ViewModels
@model SharespaceViewModel
@{
    ViewData["Title"] = "Quản lý bài đăng";
    Layout = "~/Views/Admin/AdminLayout.cshtml";
}

@section Styles {
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@3.3.2/dist/tailwind.min.css" rel="stylesheet" />
    <link href="~/css/toast_post.css" rel="stylesheet" />
}

<div class="p-6 max-w-7xl mx-auto">
    <!-- Header -->
    <div class="mb-8">
        <h1 class="text-3xl font-bold text-gray-900 mb-2">Quản lý bài đăng</h1>
        <p class="text-gray-600">Kiểm duyệt và quản lý các bài đăng trong hệ thống</p>
    </div>

    <!-- Toolbar -->
    <div class="flex flex-wrap items-center gap-4 mb-8">
        <!-- Tabs -->
        <div class="flex bg-gray-100 rounded-lg p-1">
            <button id="tab-normal" class="tab-btn px-6 py-3 rounded-md text-white bg-blue-600 font-medium text-sm flex items-center" data-tab="normal">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                Bài viết thường
                <span class="tab-count" id="normal-count">0</span>
            </button>

            <button id="tab-flagged" class="tab-btn px-6 py-3 rounded-md text-gray-700 bg-transparent font-medium text-sm flex items-center" data-tab="flagged">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z" />
                </svg>
                Cần kiểm duyệt
                <span class="tab-count" id="flagged-count">0</span>
            </button>

            <button id="tab-history" class="tab-btn px-6 py-3 rounded-md text-gray-700 bg-transparent font-medium text-sm flex items-center" data-tab="history">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                Lịch sử kiểm duyệt
                <span class="tab-count" id="history-count">0</span>
            </button>
        </div>

        <!-- Action Button -->
        <button id="btnValidateAll" data-mode="validate-all" class="ml-auto px-6 py-3 rounded-lg text-sm font-medium bg-gradient-to-r from-orange-500 to-orange-600 text-white hover:from-orange-600 hover:to-orange-700 shadow-lg hover:shadow-xl transition-all duration-200 flex items-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
            </svg>
            Kiểm duyệt tất cả bài viết
        </button>
    </div>

    <!-- Stats Summary -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-8">
        <div class="bg-blue-50 border border-blue-200 rounded-lg p-4">
            <div class="flex items-center">
                <div class="p-2 bg-blue-500 rounded-lg">
                    <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                </div>
                <div class="ml-4">
                    <p class="text-sm font-medium text-blue-600">Bài viết bình thường</p>
                    <p class="text-2xl font-bold text-blue-900" id="stats-normal">0</p>
                </div>
            </div>
        </div>

        <div class="bg-orange-50 border border-orange-200 rounded-lg p-4">
            <div class="flex items-center">
                <div class="p-2 bg-orange-500 rounded-lg">
                    <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z"></path>
                    </svg>
                </div>
                <div class="ml-4">
                    <p class="text-sm font-medium text-orange-600">Cần kiểm duyệt</p>
                    <p class="text-2xl font-bold text-orange-900" id="stats-temp-flagged">0</p>
                </div>
            </div>
        </div>

        <div class="bg-red-50 border border-red-200 rounded-lg p-4">
            <div class="flex items-center">
                <div class="p-2 bg-red-500 rounded-lg">
                    <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                </div>
                <div class="ml-4">
                    <p class="text-sm font-medium text-red-600">Đã kiểm duyệt</p>
                    <p class="text-2xl font-bold text-red-900" id="stats-flagged">0</p>
                </div>
            </div>
        </div>

        <div class="bg-gray-50 border border-gray-200 rounded-lg p-4">
            <div class="flex items-center">
                <div class="p-2 bg-gray-500 rounded-lg">
                    <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
                    </svg>
                </div>
                <div class="ml-4">
                    <p class="text-sm font-medium text-gray-600">Tổng bài viết</p>
                    <p class="text-2xl font-bold text-gray-900" id="stats-total">0</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Posts Grid -->
    <div id="posts-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
        @if (Model.Posts != null && Model.Posts.Any())
        {
            @foreach (var postInfo in Model.Posts)
            {
                var post = postInfo.Post;
                var authorName = postInfo.AuthorName;
                var authorAvatar = postInfo.AuthorAvatar ?? "/img/VN.jpg";
                var content = post.Content ?? "";
                var medias = post.Media ?? new List<Media>();
                var flagged = post.Status == "flagged";
                var flaggedReason = postInfo.FlaggedReason ?? "Bài viết vi phạm";
                var likes = post.Likes;
                var commentsCount = post.Comments?.Count ?? 0;
                var isApproved = post.Status == "approved" || post.Status == "active";

                <div class="post-card bg-white rounded-xl shadow-md overflow-hidden flex flex-col relative border border-gray-100"
                     data-status="@post.Status" data-post-id="@post.Id">

                    <div class="relative w-full h-48 bg-gray-100 overflow-hidden">
                        @{
                            var firstMediaUrl = medias.Count > 0 ? medias[0].MediaUrl : "/img/placeholder.png";
                        }
                        <img src="@firstMediaUrl" alt="Post image" class="object-cover w-full h-full" />

                        @if (flagged)
                        {
                            <div class="flagged-badge">@flaggedReason</div>
                        }

                        <div class="absolute top-3 right-3 flex space-x-2 action-buttons">
                            @if (flagged)
                            {
                                <form asp-action="ApprovePost" asp-route-postId="@post.Id" method="post" class="inline approve-form">
                                    <button type="submit" title="Duyệt bài viết" class="bg-green-500 hover:bg-green-600 p-2.5 rounded-full text-white shadow-lg hover:shadow-xl transition-all duration-200">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
                                            <path d="M13.854 3.646a.5.5 0 0 1 0 .708l-7 7a.5.5 0 0 1-.708 0l-3.5-3.5a.5.5 0 1 1 .708-.708L6.5 10.293l6.646-6.647a.5.5 0 0 1 .708 0z" />
                                        </svg>
                                    </button>
                                </form>
                            }
                            <form asp-action="DeletePost" asp-route-postId="@post.Id" method="post" class="inline">
                                <button type="submit" title="Xóa bài viết" class="bg-red-500 hover:bg-red-600 p-2.5 rounded-full text-white delete-btn shadow-lg hover:shadow-xl transition-all duration-200" data-post-id="@post.Id">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                    </svg>
                                </button>
                            </form>
                        </div>
                    </div>

                    <div class="p-5 flex flex-col flex-grow">
                        <div class="flex items-center gap-3 mb-3">
                            <img src="@authorAvatar" alt="Avatar" class="w-10 h-10 rounded-full object-cover border-2 border-gray-100" />
                            <div class="flex-1 min-w-0">
                                <div class="text-sm font-semibold text-gray-900 truncate">@authorName</div>
                                <div class="text-xs text-gray-500">@post.Timestamp.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
                            </div>
                        </div>

                        @{
                            var shortContent = content.Length > 70 ? content.Substring(0, 70) : content;
                            var isLongContent = content.Length > 70;
                        }
                        <div class="text-gray-700 mb-4 flex-grow">
                            <div class="post-content">
                                <p class="short-text text-sm leading-relaxed">@shortContent@(isLongContent ? "..." : "")</p>
                                @if (isLongContent)
                                {
                                    <p class="full-text text-sm leading-relaxed hidden">@content</p>
                                    <button type="button" class="text-blue-600 text-xs mt-1 hover:underline btn-read-more">Xem thêm</button>
                                }
                            </div>
                        </div>


                        <div class="flex justify-between items-center pt-3 border-t border-gray-100">
                            <div class="flex items-center gap-4">
                                <div class="flex items-center gap-1.5">
                                    <svg class="w-4 h-4 text-red-500" fill="currentColor" viewBox="0 0 20 20">
                                        <path fill-rule="evenodd" d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" clip-rule="evenodd" />
                                    </svg>
                                    <span class="text-sm font-medium text-gray-600">@likes</span>
                                </div>
                                <div class="flex items-center gap-1.5">
                                    <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
                                    </svg>
                                    <span class="text-sm font-medium text-gray-600">@commentsCount</span>
                                </div>
                            </div>
                            <span class="text-xs font-semibold px-3 py-1 rounded-full @(isApproved ? "bg-green-100 text-green-800" : (flagged ? "bg-red-100 text-red-800" : "bg-yellow-100 text-yellow-800"))">
                                @(isApproved ? "Đã duyệt" : (flagged ? "Đã kiểm duyệt" : "Chờ duyệt"))
                            </span>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-span-full text-center py-20">
                <svg class="mx-auto h-12 w-12 text-gray-400 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
                <h3 class="text-lg font-medium text-gray-900 mb-2">Không có bài viết nào</h3>
                <p class="text-gray-500">Chưa có bài viết nào trong hệ thống</p>
            </div>
        }
    </div>
    <div id="toast-container" class="toast-container"></div>
    <div id="custom-confirm" class="custom-confirm hidden">
        <div class="custom-confirm-backdrop"></div>
        <div class="custom-confirm-box">
            <p id="custom-confirm-message"></p>
            <div class="custom-confirm-buttons">
                <button id="custom-confirm-cancel" class="btn-cancel">Hủy</button>
                <button id="custom-confirm-ok" class="btn-ok">Xác nhận</button>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script src="~/js/kgcs/admin_post.js"></script>
}
