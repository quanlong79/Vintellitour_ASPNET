@{
    ViewData["Title"] = "Quên mật khẩu";
}

<div class="p-6 max-w-md mx-auto">
    <h2 class="text-2xl font-semibold mb-4">Quên mật khẩu</h2>

    @using (Html.BeginForm("ForgotPassword", "Account", FormMethod.Post))
    {
        <div class="mb-4">
            <input type="email"
                   name="Email"
                   placeholder="Nhập email của bạn"
                   class="w-full p-2 border rounded"
                   required />
        </div>
        <button type="submit" class="w-full bg-blue-600 text-white p-2 rounded">
            Gửi liên kết đặt lại mật khẩu
        </button>
    }

    @if (ViewBag.Message != null)
    {
        var isError = (bool)(ViewBag.IsError ?? false);
        <p class="mt-4 text-center @(isError ? "text-red-600" : "text-green-600")">
            @ViewBag.Message
        </p>
    }
</div>
