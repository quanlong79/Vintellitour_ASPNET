@model Vintellitour_Framework.ViewModels.CartViewModel

@{
    ViewData["Title"] = "Giỏ hàng";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="flex justify-between items-center mb-6">
        <h2 class="text-2xl font-bold">🛒 Giỏ hàng của bạn</h2>
        <a href="/Order/History"
           class="text-blue-600 hover:text-blue-800 font-semibold border border-blue-600 px-4 py-2 rounded-lg transition duration-200"
           title="Xem lịch sử đơn hàng">
            📜 Lịch sử đơn hàng
        </a>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Cột trái: Sản phẩm -->
        <div class="lg:col-span-2 space-y-6">
            <!-- Sản phẩm có sẵn -->
            <div class="bg-white rounded-xl shadow-md p-6">
                <h3 class="font-semibold text-lg mb-4 flex items-center">
                    <span class="w-3 h-3 bg-green-500 rounded-full mr-2"></span> Sản phẩm có sẵn (<span id="inStockCount">@Model.InStockItems.Count</span>)
                </h3>

                <div id="cartItemsContainer">
                    @foreach (var item in Model.InStockItems)
                    {
                        <div class="flex items-start justify-between border-t pt-4 first:border-t-0 first:pt-0" data-product-id="@item.Product.Id">
                            <div class="flex items-center gap-4">
                                <label class="flex items-center gap-3 cursor-pointer group">
                                    <input type="checkbox"
                                           class="hidden peer select-item"
                                           data-price="@item.Product.Price"
                                           data-original="@item.Product.OriginalPrice"
                                           data-quantity="@item.Quantity"
                                           checked />
                                    <div class="w-5 h-5 flex items-center justify-center border-2 rounded-md border-gray-300 peer-checked:bg-blue-600 peer-checked:border-blue-600 transition-all duration-200">
                                        <svg class="w-3 h-3 text-white hidden peer-checked:block" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24">
                                            <path d="M5 13l4 4L19 7" />
                                        </svg>
                                    </div>
                                </label>
                                <img src="@item.Product.Image" alt="@item.Product.Name" class="w-16 h-16 object-cover rounded-lg" />
                                <div>
                                    <p class="font-semibold text-gray-800">@item.Product.Name</p>
                                    <div class="flex items-center space-x-2">
                                        <span class="text-blue-600 font-bold">@string.Format("{0:N0} ₫", item.Product.Price)</span>
                                        <span class="text-sm text-gray-400 line-through">@string.Format("{0:N0} ₫", item.Product.OriginalPrice)</span>
                                    </div>
                                </div>
                            </div>

                            <div class="flex items-center gap-2">
                                <button class="decrease-qty w-8 h-8 border rounded text-lg">−</button>
                                <span class="font-semibold quantity">@item.Quantity</span>
                                <button class="increase-qty w-8 h-8 border rounded text-lg">+</button>
                                <button class="remove-item text-red-500 hover:text-red-700 ml-2"><i class="fas fa-trash"></i></button>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Sản phẩm hết hàng -->
            @if (Model.OutOfStockItems.Any())
            {
                <div class="bg-white rounded-xl shadow-md p-6">
                    <h3 class="font-semibold text-lg mb-4 flex items-center">
                        <span class="w-3 h-3 bg-red-500 rounded-full mr-2"></span> Sản phẩm hết hàng (@Model.OutOfStockItems.Count)
                    </h3>

                    @foreach (var item in Model.OutOfStockItems)
                    {
                        <div class="flex items-start justify-between border-t pt-4 first:border-t-0 first:pt-0 opacity-60">
                            <div class="flex items-center gap-4">
                                <img src="@item.Product.Image" alt="@item.Product.Name" class="w-16 h-16 object-cover rounded-lg grayscale" />
                                <div>
                                    <p class="font-semibold text-gray-500">@item.Product.Name</p>
                                    <span class="text-red-600 text-sm font-medium">Hết hàng</span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- Cột phải: Thanh toán -->
        <div class="space-y-6">
            <div class="bg-white rounded-xl shadow-md p-6">
                <h3 class="font-semibold text-lg mb-4">🚚 Phương thức giao hàng</h3>
                <div class="space-y-3 text-sm">
                    <label class="flex items-center justify-between border rounded-lg px-4 py-3 hover:bg-gray-50 cursor-pointer w-full">
                        <div class="flex items-center gap-2 max-w-[80%]">
                            <input type="radio" name="shipping" value="standard" class="shipping-method" checked />
                            <span class="text-gray-800 truncate">Tiêu chuẩn (3-5 ngày)</span>
                        </div>
                        <span class="text-green-600 font-semibold">Miễn phí</span>
                    </label>
                    <label class="flex items-center justify-between border rounded-lg px-4 py-3 hover:bg-gray-50 cursor-pointer w-full">
                        <div class="flex items-center gap-2 max-w-[80%]">
                            <input type="radio" name="shipping" value="express" class="shipping-method" />
                            <span class="text-gray-800 truncate">Giao nhanh (1-2 ngày)</span>
                        </div>
                        <span class="text-gray-800">50.000 ₫</span>
                    </label>
                </div>
            </div>

            <!-- Tổng -->
            <div class="bg-white rounded-xl shadow-md p-6" id="cartSummary">
                <h3 class="font-semibold text-lg mb-4">💳 Tóm tắt đơn hàng</h3>
                <div class="flex justify-between mb-2 text-sm">
                    <span>Tạm tính</span>
                    <span id="totalAmount">@string.Format("{0:N0} ₫", Model.Total)</span>
                </div>
                <div class="flex justify-between mb-2 text-sm text-green-600">
                    <span>Tiết kiệm</span>
                    <span id="discountAmount">-@string.Format("{0:N0} ₫", Model.Discount)</span>
                </div>
                <div class="flex justify-between mb-4 text-sm">
                    <span>Phí vận chuyển</span>
                    <span id="shippingFee" class="text-green-600">Miễn phí</span>
                </div>
                <hr class="my-2" />
                <div class="flex justify-between font-bold text-lg">
                    <span>Thành tiền</span>
                    <span id="grandTotal">@string.Format("{0:N0} ₫", Model.GrandTotal)</span>
                </div>
                @* <button class="w-full mt-6 bg-blue-600 text-white rounded-lg py-3 hover:bg-blue-700 transition font-semibold">Tiến hành thanh toán</button> *@
                <form method="POST" asp-action="CreatePaymentUrl" asp-controller="Payment" id="paymentForm">
                    <input type="hidden" name="FullName" value="@User.Identity.Name" />
                    <input type="hidden" name="Amount" value="@Model.GrandTotal" />
                    <input type="hidden" name="OrderInfo" value="Thanh toán đặt hàng qua Momo tại Vintellitour" />
                    <label for="OrderNote" class="block mb-1 font-semibold">Ghi chú đơn hàng & số đăng kí MOMO:</label>
                    <textarea id="OrderNote" name="OrderNote" rows="3" class="w-full border rounded p-2 mb-4" placeholder="Nhập ghi chú nếu có..." required></textarea>

                    <input type="hidden" name="CartItemsJson" id="CartItemsJson" />

                    <!-- Checkbox đồng ý điều khoản -->
                    <div class="flex items-center gap-2 mt-4">
                        <input type="checkbox" id="agreeTerms" class="w-4 h-4" />
                        <label for="agreeTerms" class="text-sm text-gray-700 cursor-pointer select-none">
                            Tôi đồng ý với <a href="/pdf/payment_terms.pdf" target="_blank" class="text-blue-600 underline">điều khoản thanh toán</a>
                        </label>
                    </div>

                    <button type="submit" class="w-full mt-6 bg-blue-600 text-white rounded-lg py-3 hover:bg-blue-700 transition font-semibold" id="submitBtn" disabled>
                        Tiến hành thanh toán
                    </button>
                </form>



            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const formatCurrency = amount => amount.toLocaleString('vi-VN') + ' ₫';

        function updateSummary() {
            let total = 0;
            let discount = 0;

            document.querySelectorAll('.select-item:checked').forEach(cb => {
                const price = parseInt(cb.dataset.price || "0");
                const original = parseInt(cb.dataset.original || "0");
                const quantity = parseInt(cb.dataset.quantity || "1");

                total += price * quantity;
                discount += (original - price) * quantity;
            });

            const shippingInput = document.querySelector('.shipping-method:checked');
            let shippingFee = shippingInput && shippingInput.value === 'express' ? 50000 : 0;

            document.getElementById('totalAmount').textContent = formatCurrency(total);
            document.getElementById('discountAmount').textContent = '-' + formatCurrency(discount);
            document.getElementById('shippingFee').textContent = shippingFee > 0 ? formatCurrency(shippingFee) : 'Miễn phí';
            document.getElementById('shippingFee').classList.toggle('text-green-600', shippingFee === 0);
            document.getElementById('grandTotal').textContent = formatCurrency(total + shippingFee);

            // Update lại giá trị amount trong input hidden form
            const amountInput = document.querySelector('input[name="Amount"]');
            if (amountInput) {
                amountInput.value = total + shippingFee;
            }
                    const agreeCheckbox = document.getElementById('agreeTerms');
        const submitBtn = document.getElementById('submitBtn');

        // Bỏ disable nút submit (luôn cho phép click)
        submitBtn.disabled = false;

        // Bắt sự kiện submit form, kiểm tra checkbox
        document.getElementById('paymentForm').addEventListener('submit', function (e) {
            if (!agreeCheckbox.checked) {
                e.preventDefault(); // chặn gửi form
                toastr.error('Bạn phải đồng ý với điều khoản thanh toán để tiếp tục.');
                agreeCheckbox.focus();
                return false;
            }
        });
        }


            // Gọi lại updateSummary sau mỗi lần số lượng, checkbox hoặc phương thức vận chuyển thay đổi
            function registerDynamicEvents() {
                document.querySelectorAll('.increase-qty').forEach(btn => {
                    btn.addEventListener('click', e => {
                        const productId = e.target.closest('[data-product-id]').dataset.productId;
                        fetch(`/Cart/IncreaseQuantity?id=${productId}`, { method: 'POST' })
                            .then(() => location.reload());
                    });
                });

                document.querySelectorAll('.decrease-qty').forEach(btn => {
                    btn.addEventListener('click', e => {
                        const productId = e.target.closest('[data-product-id]').dataset.productId;
                        fetch(`/Cart/DecreaseQuantity?id=${productId}`, { method: 'POST' })
                            .then(() => location.reload());
                    });
                });

                document.querySelectorAll('.remove-item').forEach(btn => {
                    btn.addEventListener('click', e => {
                        const productId = e.target.closest('[data-product-id]').dataset.productId;
                        fetch(`/Cart/Remove?id=${productId}`, { method: 'POST' })
                            .then(() => location.reload());
                    });
                });

                document.querySelectorAll('.select-item').forEach(cb => {
                    cb.addEventListener('change', updateSummary);
                });

                document.querySelectorAll('.shipping-method').forEach(input => {
                    input.addEventListener('change', updateSummary);
                });
            }

            document.getElementById('paymentForm').addEventListener('submit', function(e) {
                const cartItems = [];

                document.querySelectorAll('#cartItemsContainer > div').forEach(itemDiv => {
                    const checkbox = itemDiv.querySelector('.select-item');
                    if (!checkbox || !checkbox.checked) return; // chỉ lấy sản phẩm được chọn

                    const productId = itemDiv.getAttribute('data-product-id');
                    const quantity = parseInt(checkbox.dataset.quantity || "1");
                    const price = parseInt(checkbox.dataset.price || "0");
                    const originalPrice = parseInt(checkbox.dataset.original || "0");
                    const productName = itemDiv.querySelector('p.font-semibold')?.innerText || "";

                    cartItems.push({
                        ProductId: productId,
                        ProductName: productName,
                        Quantity: quantity,
                        Price: price,
                        OriginalPrice: originalPrice
                    });
            });

            // Gán JSON string vào input ẩn
            document.getElementById('CartItemsJson').value = JSON.stringify(cartItems);
        });


            registerDynamicEvents();
            updateSummary(); // Lần đầu tải trang
        });

         document.getElementById('paymentForm').addEventListener('submit', function(e) {
            const cartItems = [];

            document.querySelectorAll('#cartItemsContainer > div').forEach(itemDiv => {
                const checkbox = itemDiv.querySelector('.select-item');
                if (!checkbox || !checkbox.checked) return;

                cartItems.push({
                    ProductId: itemDiv.getAttribute('data-product-id'),
                    Quantity: parseInt(checkbox.dataset.quantity || "1"),
                    Price: parseInt(checkbox.dataset.price || "0"),
                    ProductName: itemDiv.querySelector('p.font-semibold')?.innerText || "",
                    OriginalPrice: parseInt(checkbox.dataset.original || "0")
                });
            });

            if (cartItems.length === 0) {
                e.preventDefault();  // chặn submit form
                toastr.error('Vui lòng chọn ít nhất một sản phẩm để thanh toán!');
                return;
            }

            document.getElementById('CartItemsJson').value = JSON.stringify(cartItems);
        });

        $(function () {
            var message = '@Html.Raw(TempData["Message"])';
            var messageType = '@TempData["MessageType"]' || 'info'; // success, info, warning, error

            if (message) {
                toastr[messageType](message);
            }
        });
    </script>

}