@model ResetPasswordModel

@{
    ViewData["Title"] = "Đặt lại mật khẩu";
}

<div class="max-w-md mx-auto p-6">
    <h2 class="text-2xl font-semibold mb-4">Đặt lại mật khẩu</h2>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="text-red-600 mb-4">
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <p>@error.ErrorMessage</p>
            }
        </div>
    }

    <form asp-action="ResetPassword" method="post" class="space-y-4">
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.Token)

        <input asp-for="Password" type="password" placeholder="Mật khẩu mới"
               class="w-full p-2 border rounded" />
        <span asp-validation-for="Password" class="text-red-500"></span>

        <input asp-for="ConfirmPassword" type="password" placeholder="Xác nhận mật khẩu"
               class="w-full p-2 border rounded" />
        <span asp-validation-for="ConfirmPassword" class="text-red-500"></span>

        <button type="submit" class="w-full bg-blue-600 text-white p-2 rounded">
            Đổi mật khẩu
        </button>
    </form>

    @if (TempData["Success"] != null)
    {
        <p class="mt-4 text-green-600 text-center">@TempData["Success"]</p>
    }
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
