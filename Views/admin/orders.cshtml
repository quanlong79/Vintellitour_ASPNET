@model List<Vintellitour_Framework.Models.Payment>

@{
    ViewData["Title"] = "Quản lý đơn hàng";
    Layout = "~/Views/admin/adminlayout.cshtml";
}

<!-- Header -->
<div class="bg-gradient-to-r from-blue-600 via-purple-600 to-blue-800 py-16">
    <div class="container mx-auto px-4">
        <h1 class="text-4xl font-bold text-white text-center mb-2">Quản lý Đơn hàng</h1>
        <p class="text-blue-100 text-center">Theo dõi và quản lý tất cả đơn hàng của bạn</p>
    </div>
</div>

<div class="container mx-auto px-4 -mt-16 relative z-10">
    <!-- Stats Cards -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
        <div class="bg-white rounded-xl shadow-lg p-6 text-center transform hover:scale-105 transition-transform duration-200">
            <div class="text-3xl font-bold text-blue-600" id="total-orders">@Model.Count</div>
            <div class="text-gray-600 mt-1">Tổng đơn hàng</div>
        </div>
        <div class="bg-white rounded-xl shadow-lg p-6 text-center transform hover:scale-105 transition-transform duration-200">
            <div class="text-3xl font-bold text-green-600" id="success-orders">@Model.Count(p => p.Status == "Success")</div>
            <div class="text-gray-600 mt-1">Thành công</div>
        </div>
        <div class="bg-white rounded-xl shadow-lg p-6 text-center transform hover:scale-105 transition-transform duration-200">
            <div class="text-3xl font-bold text-yellow-600" id="shipping-orders">@Model.Count(p => p.ShippingStatus == "Đang vận chuyển")</div>
            <div class="text-gray-600 mt-1">Đang vận chuyển</div>
        </div>
        <div class="bg-white rounded-xl shadow-lg p-6 text-center transform hover:scale-105 transition-transform duration-200">
            <div class="text-3xl font-bold text-purple-600" id="total-revenue">@String.Format("{0:N0}", Model.Where(p => p.Status == "Success").Sum(p => p.Amount))</div>
            <div class="text-gray-600 mt-1">Tổng doanh thu (VNĐ)</div>
        </div>
    </div>

    <!-- Orders Table -->
    <div class="bg-white rounded-2xl shadow-xl overflow-hidden">
        <div class="px-6 py-4 bg-gradient-to-r from-gray-50 to-gray-100 border-b border-gray-200">
            <h2 class="text-xl font-semibold text-gray-800 flex items-center">
                <span class="bg-blue-500 text-white rounded-full w-8 h-8 flex items-center justify-center text-sm mr-3">📋</span>
                Danh sách đơn hàng
            </h2>
        </div>

        <div class="overflow-x-auto">
            <table class="min-w-full">
                <thead class="bg-gradient-to-r from-gray-100 to-gray-200">
                    <tr>
                        <th class="px-6 py-4 text-left text-sm font-semibold text-gray-700 w-16">#</th>
                        <th class="px-6 py-4 text-left text-sm font-semibold text-gray-700">ID Đơn hàng</th>
                        <th class="px-6 py-4 text-left text-sm font-semibold text-gray-700">Người dùng</th>
                        <th class="px-6 py-4 text-left text-sm font-semibold text-gray-700">Số tiền</th>
                        <th class="px-6 py-4 text-left text-sm font-semibold text-gray-700">Trạng thái thanh toán</th>
                        <th class="px-6 py-4 text-left text-sm font-semibold text-gray-700">Trạng thái vận chuyển</th>
                        <th class="px-6 py-4 text-left text-sm font-semibold text-gray-700">Hành động</th>
                    </tr>
                </thead>
                <tbody id="orders-table-body">
                    @for (int i = 0; i < Model.Count; i++)
                    {
                        var payment = Model[i];
                        var shippingStatus = string.IsNullOrEmpty(payment.ShippingStatus) ? "Chờ vận chuyển" : payment.ShippingStatus;
                        <tr class="border-b border-gray-100 hover:bg-gradient-to-r hover:from-blue-50 hover:to-purple-50 transition-all duration-300 transform hover:scale-[1.01]">
                            <td class="px-6 py-4 text-center">
                                <button aria-label="Toggle details" class="text-xl font-bold text-gray-600 hover:text-blue-600 transition-all duration-200 transform hover:rotate-90" data-id="@payment.Id.ToString()">▶</button>
                            </td>
                            <td class="px-6 py-4 font-semibold text-gray-900">@payment.Id</td>
                            <td class="px-6 py-4 text-gray-700 font-medium">@payment.UserId</td>
                            <td class="px-6 py-4 font-bold text-green-600">@String.Format("{0:N0} VNĐ", payment.Amount)</td>
                            <td class="px-6 py-4">
                                @if (payment.Status == "Success")
                                {
                                    <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-green-100 text-green-800 border border-green-200">
                                        ✓ Thành công
                                    </span>
                                }
                                else if (payment.Status == "Pending")
                                {
                                    <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800 border border-yellow-200 animate-pulse">
                                        ⏳ Chờ xử lý
                                    </span>
                                }
                                else if (payment.Status == "Cancel")
                                {
                                    <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-red-100 text-red-800 border border-red-200">
                                        🛑 Đã hủy
                                    </span>
                                }
                                else if (payment.Status == "Failed")
                                {
                                    <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-red-100 text-red-800 border border-red-200">
                                        ✗ Thất bại
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-gray-100 text-gray-800 border border-gray-200">
                                        @payment.Status
                                    </span>
                                }
                            </td>
                            <td class="px-6 py-4">
                                @if (payment.Status == "Success")
                                {
                                    @if (shippingStatus == "Đang vận chuyển")
                                    {
                                        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-blue-100 text-blue-800 border border-blue-200 animate-pulse">
                                            🚚 Đang vận chuyển
                                        </span>
                                    }
                                    else if (shippingStatus == "Vận chuyển thành công")
                                    {
                                        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-green-100 text-green-800 border border-green-200">
                                            ✅ Đã giao
                                        </span>
                                    }
                                    else if (shippingStatus == "Vận chuyển thất bại")
                                    {
                                        <button data-id="@payment.Id" data-action="confirm"
                                                class="bg-yellow-500 hover:bg-yellow-600 text-white px-3 py-2 rounded-lg text-sm font-medium transition-all duration-200 transform hover:scale-105 shadow-md hover:shadow-lg">
                                            🔄 Xác nhận vận chuyển
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-gray-100 text-gray-800 border border-gray-200">
                                            📦 Chờ vận chuyển
                                        </span>
                                    }
                                }
                                else
                                {
                                    <span class="text-gray-400">-</span>
                                }
                            </td>
                            <td class="px-6 py-4">
                                @if (payment.Status == "Success")
                                {
                                    if (string.IsNullOrEmpty(payment.ShippingStatus))
                                    {
                                        <button data-id="@payment.Id" data-action="start" class="bg-blue-500 hover:bg-blue-600 text-white px-4 py-2 rounded-lg text-sm font-medium transition-all duration-200 transform hover:scale-105 shadow-md hover:shadow-lg">
                                            🚀 Bắt đầu vận chuyển
                                        </button>
                                    }
                                    else if (payment.ShippingStatus == "Đang vận chuyển")
                                    {
                                        <div class="flex flex-col sm:flex-row gap-2">
                                            <button data-id="@payment.Id" data-action="success" class="bg-green-500 hover:bg-green-600 text-white px-3 py-2 rounded-lg text-sm font-medium transition-all duration-200 transform hover:scale-105 shadow-md hover:shadow-lg">
                                                ✅ Giao thành công
                                            </button>
                                            <button data-id="@payment.Id" data-action="fail" class="bg-red-500 hover:bg-red-600 text-white px-3 py-2 rounded-lg text-sm font-medium transition-all duration-200 transform hover:scale-105 shadow-md hover:shadow-lg">
                                                ❌ Giao thất bại
                                            </button>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-green-600 font-medium text-sm">@payment.ShippingStatus</span>
                                    }
                                }
                                else
                                {
                                    <span class="text-gray-400 text-sm">-</span>
                                }
                            </td>
                        </tr>
                        <tr id="details-@payment.Id" class="bg-gradient-to-r from-gray-50 to-blue-50 hidden">
                            <td colspan="7" class="px-8 py-6">
                                <div class="bg-white rounded-xl p-6 shadow-lg border border-gray-200">
                                    <h4 class="font-semibold text-gray-800 mb-4 flex items-center text-lg">
                                        <span class="bg-blue-500 text-white px-3 py-1 rounded-full text-sm mr-3">📦</span>
                                        Chi tiết đơn hàng @payment.Id
                                    </h4>
                                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                                        @foreach (var detail in payment.Details)
                                        {
                                            <div class="bg-gradient-to-br from-white to-gray-50 rounded-lg p-4 border border-gray-200 shadow-sm hover:shadow-md transition-shadow duration-200">
                                                <div class="font-semibold text-gray-800 mb-2">@detail.ProductName</div>
                                                <div class="flex justify-between items-center">
                                                    <div class="text-sm text-gray-600">
                                                        <span class="bg-gray-100 px-2 py-1 rounded-full">Số lượng: @detail.Quantity</span>
                                                    </div>
                                                    <div class="text-lg font-bold text-green-600">@String.Format("{0:N0} VNĐ", detail.Price)</div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    document.getElementById("orders-table-body").addEventListener("click", function(e){
        const target = e.target;

        // Toggle chi tiết đơn hàng
        if(target.tagName === "BUTTON" && target.getAttribute("aria-label") === "Toggle details"){
            const id = target.getAttribute("data-id");
            const detailsRow = document.getElementById("details-" + id);

            if(detailsRow.classList.contains("hidden")){
                detailsRow.classList.remove("hidden");
                target.textContent = "▼";
                target.style.transform = "rotate(90deg)";
            } else {
                detailsRow.classList.add("hidden");
                target.textContent = "▶";
                target.style.transform = "rotate(0deg)";
            }
        }

        // Xử lý các nút cập nhật trạng thái vận chuyển
        if(target.tagName === "BUTTON" && target.dataset.action){
            const paymentId = target.dataset.id;
            const row = target.closest('tr');
            const shippingCell = row.cells[5]; // Cột trạng thái vận chuyển
            const actionCell = row.cells[6];   // Cột hành động

            let newShippingBadge = "";
            let newActionContent = "";
            let newShippingStatus = "";

            switch(target.dataset.action){
                case "start":
                    newShippingBadge = '<span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-blue-100 text-blue-800 border border-blue-200 animate-pulse">🚚 Đang vận chuyển</span>';
                    newActionContent = `
                        <div class="flex flex-col sm:flex-row gap-2">
                            <button data-id="${paymentId}" data-action="success" class="bg-green-500 hover:bg-green-600 text-white px-3 py-2 rounded-lg text-sm font-medium transition-all duration-200 transform hover:scale-105 shadow-md hover:shadow-lg">
                                ✅ Giao thành công
                            </button>
                            <button data-id="${paymentId}" data-action="fail" class="bg-red-500 hover:bg-red-600 text-white px-3 py-2 rounded-lg text-sm font-medium transition-all duration-200 transform hover:scale-105 shadow-md hover:shadow-lg">
                                ❌ Giao thất bại
                            </button>
                        </div>
                    `;
                    newShippingStatus = "Đang vận chuyển";
                    break;
                case "success":
                    newShippingBadge = '<span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-green-100 text-green-800 border border-green-200">✅ Đã giao</span>';
                    newActionContent = '<span class="text-green-600 font-medium text-sm">Vận chuyển thành công</span>';
                    newShippingStatus = "Vận chuyển thành công";
                    break;
                case "fail":
                    newShippingBadge = '<span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-red-100 text-red-800 border border-red-200">❌ Giao thất bại</span>';
                    newActionContent = `
                        <button data-id="${paymentId}" data-action="confirm"
                                class="bg-yellow-500 hover:bg-yellow-600 text-white px-3 py-2 rounded-lg text-sm font-medium transition-all duration-200 transform hover:scale-105 shadow-md hover:shadow-lg">
                            🔄 Xác nhận vận chuyển
                        </button>
                    `;
                    newShippingStatus = "Vận chuyển thất bại";
                    break;
                case "confirm":
                    newShippingBadge = '<span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-green-100 text-green-800 border border-green-200">✅ Đã giao</span>';
                    newActionContent = '<span class="text-green-600 font-medium text-sm">Vận chuyển thành công</span>';
                    newShippingStatus = "Vận chuyển thành công";
                    break;
            }

            // Cập nhật UI ngay
            shippingCell.innerHTML = newShippingBadge;
            actionCell.innerHTML = newActionContent;

            // Gọi API backend cập nhật trạng thái vận chuyển
            fetch('/Admin/UpdateShippingStatus', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    paymentId: paymentId,
                    newShippingStatus: newShippingStatus
                })
            })
            .then(res => res.json())
            .then(data => {
                if (!data.success) {
                    showNotification('Cập nhật trạng thái thất bại!', 'error');
                    // Có thể rollback UI nếu muốn
                } else {
                    showNotification(data.message, 'success');
                }
            })
            .catch(() => {
                showNotification('Lỗi kết nối máy chủ!', 'error');
                // Có thể rollback UI nếu muốn
            });
        }
    });

    function showNotification(message, type) {
        const notification = document.createElement('div');
        notification.className = `fixed top-4 right-4 px-6 py-3 rounded-lg shadow-lg z-50 transform transition-all duration-300 ${
            type === 'success' ? 'bg-green-500 text-white' : 'bg-red-500 text-white'
        }`;
        notification.textContent = message;

        document.body.appendChild(notification);

        setTimeout(() => {
            notification.style.transform = 'translateX(100%)';
            setTimeout(() => {
                if (document.body.contains(notification)) {
                    document.body.removeChild(notification);
                }
            }, 300);
        }, 3000);
    }
</script>
