@model Vintellitour_Framework.Models.Product
@{
    ViewData["Title"] = "Thêm sản phẩm mới";
}

<div class="min-h-screen bg-gradient-to-br from-teal-50 to-cyan-50 py-8">
    <div class="max-w-4xl mx-auto px-4">
        <!-- Header Section -->
        <div class="text-center mb-8">
            <div class="inline-flex items-center justify-center w-16 h-16 bg-teal-100 rounded-full mb-4">
                <svg class="w-8 h-8 text-teal-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
                </svg>
            </div>
            <h1 class="text-3xl font-bold text-gray-800 mb-2">@ViewData["Title"]</h1>
            <p class="text-gray-600">Điền thông tin chi tiết để thêm sản phẩm mới vào hệ thống</p>
        </div>

        <!-- Main Form Card -->
        <div class="bg-white rounded-2xl shadow-xl border border-gray-100 overflow-hidden">
            <div class="bg-gradient-to-r from-teal-600 to-cyan-600 px-8 py-6">
                <h2 class="text-xl font-semibold text-white">Thông tin sản phẩm</h2>
            </div>

            <form id="productCreateForm" action="@Url.Action("Create", "AdminProduct", new { area = "" })" method="post" class="p-8 space-y-8" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <!-- Basic Information Section -->
                <div class="space-y-6">
                    <div class="border-l-4 border-teal-500 pl-4">
                        <h3 class="text-lg font-semibold text-gray-800 mb-4">Thông tin cơ bản</h3>
                    </div>

                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                        <div class="lg:col-span-2">
                            <label asp-for="Name" class="block text-sm font-semibold text-gray-700 mb-2">
                                <span class="flex items-center">
                                    <svg class="w-4 h-4 mr-2 text-teal-600" fill="currentColor" viewBox="0 0 20 20">
                                        <path d="M4 4a2 2 0 00-2 2v1h16V6a2 2 0 00-2-2H4z"></path>
                                        <path fill-rule="evenodd" d="M18 9H2v5a2 2 0 002 2h12a2 2 0 002-2V9zM4 13a1 1 0 011-1h1a1 1 0 110 2H5a1 1 0 01-1-1zm5-1a1 1 0 100 2h1a1 1 0 100-2H9z" clip-rule="evenodd"></path>
                                    </svg>
                                    Tên sản phẩm
                                </span>
                            </label>
                            <input asp-for="Name" class="w-full border-2 border-gray-200 rounded-lg px-4 py-3 focus:border-teal-500 focus:ring-2 focus:ring-teal-200 transition-all duration-200 bg-gray-50 focus:bg-white" placeholder="Nhập tên sản phẩm..." />
                            <span asp-validation-for="Name" class="text-red-500 text-sm mt-1 block"></span>
                        </div>

                        <div class="lg:col-span-2">
                            <label asp-for="Description" class="block text-sm font-semibold text-gray-700 mb-2">
                                <span class="flex items-center">
                                    <svg class="w-4 h-4 mr-2 text-teal-600" fill="currentColor" viewBox="0 0 20 20">
                                        <path fill-rule="evenodd" d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4zm2 6a1 1 0 011-1h6a1 1 0 110 2H7a1 1 0 01-1-1zm1 3a1 1 0 100 2h6a1 1 0 100-2H7z" clip-rule="evenodd"></path>
                                    </svg>
                                    Mô tả sản phẩm
                                </span>
                            </label>
                            <textarea asp-for="Description" rows="4" class="w-full border-2 border-gray-200 rounded-lg px-4 py-3 focus:border-teal-500 focus:ring-2 focus:ring-teal-200 transition-all duration-200 bg-gray-50 focus:bg-white resize-none" placeholder="Mô tả chi tiết về sản phẩm..."></textarea>
                            <span asp-validation-for="Description" class="text-red-500 text-sm mt-1 block"></span>
                        </div>

                        <div class="lg:col-span-2">
                            <label asp-for="Image" class="block text-sm font-semibold text-gray-700 mb-2">
                                <span class="flex items-center">
                                    <svg class="w-4 h-4 mr-2 text-teal-600" fill="currentColor" viewBox="0 0 20 20">
                                        <path fill-rule="evenodd" d="M4 3a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V5a2 2 0 00-2-2H4zm12 12H4l4-8 3 6 2-4 3 6z" clip-rule="evenodd"></path>
                                    </svg>
                                    URL ảnh sản phẩm
                                </span>
                            </label>
                            <input asp-for="Image" class="w-full border-2 border-gray-200 rounded-lg px-4 py-3 focus:border-teal-500 focus:ring-2 focus:ring-teal-200 transition-all duration-200 bg-gray-50 focus:bg-white" placeholder="/img/placeholder.png" />
                            <span asp-validation-for="Image" class="text-red-500 text-sm mt-1 block"></span>
                        </div>

                        <div>
                            <label asp-for="Category" class="block text-sm font-semibold text-gray-700 mb-2">
                                <span class="flex items-center">
                                    <svg class="w-4 h-4 mr-2 text-teal-600" fill="currentColor" viewBox="0 0 20 20">
                                        <path d="M7 3a1 1 0 000 2h6a1 1 0 100-2H7zM4 7a1 1 0 011-1h10a1 1 0 110 2H5a1 1 0 01-1-1zM2 11a2 2 0 012-2h12a2 2 0 012 2v4a2 2 0 01-2 2H4a2 2 0 01-2-2v-4z"></path>
                                    </svg>
                                    Danh mục
                                </span>
                            </label>

                            <select asp-for="Category" class="w-full border-2 border-gray-200 rounded-lg px-4 py-3 focus:border-teal-500 focus:ring-2 focus:ring-teal-200 transition-all duration-200 bg-gray-50 focus:bg-white">
                                <option value="">-- Chọn danh mục --</option>
                                <option value="Bản đồ">Bản đồ</option>
                                <option value="Balo">Ba lô</option>
                                <option value="Điện tử">Điện tử</option>
                                <option value="Phụ kiện">Phụ kiện</option>
                            </select>

                            <span asp-validation-for="Category" class="text-red-500 text-sm mt-1 block"></span>
                        </div>

                        <div>
                            <label asp-for="Stock" class="block text-sm font-semibold text-gray-700 mb-2">
                                <span class="flex items-center">
                                    <svg class="w-4 h-4 mr-2 text-teal-600" fill="currentColor" viewBox="0 0 20 20">
                                        <path d="M5 4a2 2 0 012-2h6a2 2 0 012 2v14l-5-2.5L5 18V4z"></path>
                                    </svg>
                                    Số lượng tồn kho
                                </span>
                            </label>
                            <input asp-for="Stock" type="number" class="w-full border-2 border-gray-200 rounded-lg px-4 py-3 focus:border-teal-500 focus:ring-2 focus:ring-teal-200 transition-all duration-200 bg-gray-50 focus:bg-white" placeholder="0" />
                            <span asp-validation-for="Stock" class="text-red-500 text-sm mt-1 block"></span>
                        </div>
                    </div>
                </div>

                <!-- Pricing Section -->
                <div class="space-y-6">
                    <div class="border-l-4 border-teal-500 pl-4">
                        <h3 class="text-lg font-semibold text-gray-800 mb-4">Thông tin giá cả</h3>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div class="relative">
                            <label asp-for="Price" class="block text-sm font-semibold text-gray-700 mb-2">
                                <span class="flex items-center">
                                    <svg class="w-4 h-4 mr-2 text-teal-600" fill="currentColor" viewBox="0 0 20 20">
                                        <path d="M8.433 7.418c.155-.103.346-.196.567-.267v1.698a2.305 2.305 0 01-.567-.267C8.07 8.34 8 8.114 8 8c0-.114.07-.34.433-.582zM11 12.849v-1.698c.22.071.412.164.567.267.364.243.433.468.433.582 0 .114-.07.34-.433.582a2.305 2.305 0 01-.567.267z"></path>
                                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-13a1 1 0 10-2 0v.092a4.535 4.535 0 00-1.676.662C6.602 6.234 6 7.009 6 8c0 .99.602 1.765 1.324 2.246.48.32 1.054.545 1.676.662v1.941c-.391-.127-.68-.317-.843-.504a1 1 0 10-1.51 1.31c.562.649 1.413 1.076 2.353 1.253V15a1 1 0 102 0v-.092a4.535 4.535 0 001.676-.662C13.398 13.766 14 12.991 14 12c0-.99-.602-1.765-1.324-2.246A4.535 4.535 0 0011 9.092V7.151c.391.127.68.317.843.504a1 1 0 101.511-1.31c-.563-.649-1.413-1.076-2.354-1.253V5z" clip-rule="evenodd"></path>
                                    </svg>
                                    Giá bán
                                </span>
                            </label>
                            <div class="relative">
                                <span class="absolute left-3 top-1/2 transform -translate-y-1/2 text-gray-500 font-medium">₫</span>
                                <input asp-for="Price" type="number" step="0.01" class="w-full border-2 border-gray-200 rounded-lg pl-8 pr-4 py-3 focus:border-teal-500 focus:ring-2 focus:ring-teal-200 transition-all duration-200 bg-gray-50 focus:bg-white" placeholder="0.00" />
                            </div>
                            <span asp-validation-for="Price" class="text-red-500 text-sm mt-1 block"></span>
                        </div>

                        <div class="relative">
                            <label asp-for="OriginalPrice" class="block text-sm font-semibold text-gray-700 mb-2">
                                <span class="flex items-center">
                                    <svg class="w-4 h-4 mr-2 text-teal-600" fill="currentColor" viewBox="0 0 20 20">
                                        <path d="M8.433 7.418c.155-.103.346-.196.567-.267v1.698a2.305 2.305 0 01-.567-.267C8.07 8.34 8 8.114 8 8c0-.114.07-.34.433-.582zM11 12.849v-1.698c.22.071.412.164.567.267.364.243.433.468.433.582 0 .114-.07.34-.433.582a2.305 2.305 0 01-.567.267z"></path>
                                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-13a1 1 0 10-2 0v.092a4.535 4.535 0 00-1.676.662C6.602 6.234 6 7.009 6 8c0 .99.602 1.765 1.324 2.246.48.32 1.054.545 1.676.662v1.941c-.391-.127-.68-.317-.843-.504a1 1 0 10-1.51 1.31c.562.649 1.413 1.076 2.353 1.253V15a1 1 0 102 0v-.092a4.535 4.535 0 001.676-.662C13.398 13.766 14 12.991 14 12c0-.99-.602-1.765-1.324-2.246A4.535 4.535 0 0011 9.092V7.151c.391.127.68.317.843.504a1 1 0 101.511-1.31c-.563-.649-1.413-1.076-2.354-1.253V5z" clip-rule="evenodd"></path>
                                    </svg>
                                    Giá gốc
                                </span>
                            </label>
                            <div class="relative">
                                <span class="absolute left-3 top-1/2 transform -translate-y-1/2 text-gray-500 font-medium">₫</span>
                                <input asp-for="OriginalPrice" type="number" step="0.01" class="w-full border-2 border-gray-200 rounded-lg pl-8 pr-4 py-3 focus:border-teal-500 focus:ring-2 focus:ring-teal-200 transition-all duration-200 bg-gray-50 focus:bg-white" placeholder="0.00" />
                            </div>
                            <span asp-validation-for="OriginalPrice" class="text-red-500 text-sm mt-1 block"></span>
                        </div>
                    </div>
                </div>

                <!-- Product Status Section -->
                <div class="space-y-6">
                    <div class="border-l-4 border-teal-500 pl-4">
                        <h3 class="text-lg font-semibold text-gray-800 mb-4">Trạng thái sản phẩm</h3>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div class="bg-gradient-to-r from-teal-50 to-cyan-50 rounded-lg p-4 border border-teal-100">
                            <label class="flex items-center cursor-pointer">
                                <input asp-for="IsNew" type="checkbox" class="w-5 h-5 text-teal-600 border-2 border-gray-300 rounded focus:ring-teal-500 focus:ring-2" />
                                <span class="ml-3 text-sm font-medium text-gray-700 flex items-center">
                                    <svg class="w-4 h-4 mr-2 text-teal-600" fill="currentColor" viewBox="0 0 20 20">
                                        <path fill-rule="evenodd" d="M12.395 2.553a1 1 0 00-1.45-.385c-.345.23-.614.558-.822.88-.214.33-.403.713-.57 1.116-.334.804-.614 1.768-.84 2.734a31.365 31.365 0 00-.613 3.58 2.64 2.64 0 01-.945-1.067c-.328-.68-.398-1.534-.398-2.654A1 1 0 005.05 6.05 6.981 6.981 0 003 11a7 7 0 1011.95-4.95c-.592-.591-.98-.985-1.348-1.467-.363-.476-.724-1.063-1.207-2.03zM12.12 15.12A3 3 0 017 13s.879.5 2.5.5c0-1 .5-4 1.25-4.5.5 1 .786 1.293 1.371 1.879A2.99 2.99 0 0113 13a2.99 2.99 0 01-.879 2.121z" clip-rule="evenodd"></path>
                                    </svg>
                                    Sản phẩm mới
                                </span>
                            </label>
                        </div>

                        <div class="bg-gradient-to-r from-teal-50 to-cyan-50 rounded-lg p-4 border border-teal-100">
                            <label class="flex items-center cursor-pointer">
                                <input asp-for="IsBestSeller" type="checkbox" class="w-5 h-5 text-teal-600 border-2 border-gray-300 rounded focus:ring-teal-500 focus:ring-2" />
                                <span class="ml-3 text-sm font-medium text-gray-700 flex items-center">
                                    <svg class="w-4 h-4 mr-2 text-teal-600" fill="currentColor" viewBox="0 0 20 20">
                                        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
                                    </svg>
                                    Sản phẩm bán chạy
                                </span>
                            </label>
                        </div>
                    </div>
                </div>

                <!-- Product Details Section -->
                <div class="space-y-6">
                    <div class="border-l-4 border-teal-500 pl-4">
                        <h3 class="text-lg font-semibold text-gray-800 mb-4">Chi tiết bổ sung</h3>
                    </div>

                    <div>
                        <label asp-for="Details" class="block text-sm font-semibold text-gray-700 mb-2">
                            <span class="flex items-center">
                                <svg class="w-4 h-4 mr-2 text-teal-600" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4z" clip-rule="evenodd"></path>
                                </svg>
                                Chi tiết sản phẩm
                            </span>
                        </label>
                        <textarea asp-for="Details" rows="5" class="w-full border-2 border-gray-200 rounded-lg px-4 py-3 focus:border-teal-500 focus:ring-2 focus:ring-teal-200 transition-all duration-200 bg-gray-50 focus:bg-white resize-none" placeholder="Thêm thông tin chi tiết về sản phẩm, đặc điểm nổi bật, cách sử dụng..."></textarea>
                    </div>
                </div>

                <!-- Action Buttons -->
                <div class="flex flex-col sm:flex-row gap-4 pt-6 border-t border-gray-200">
                    <button type="submit" class="flex-1 bg-gradient-to-r from-teal-600 to-cyan-600 hover:from-teal-700 hover:to-cyan-700 text-white px-8 py-4 rounded-lg font-semibold shadow-lg hover:shadow-xl transform hover:scale-105 transition-all duration-200 flex items-center justify-center">
                        <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd"></path>
                        </svg>
                        Thêm sản phẩm
                    </button>
                    <button type="button" onclick="window.history.back()" class="flex-1 sm:flex-none bg-gray-100 hover:bg-gray-200 text-gray-700 px-8 py-4 rounded-lg font-semibold border border-gray-300 transition-all duration-200 flex items-center justify-center">
                        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                        </svg>
                        Quay lại
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
          const form = document.getElementById('productCreateForm');

          form.addEventListener('submit', function (e) {
            e.preventDefault();

            const formData = new FormData(form);

            // DEBUG: Log form data
            console.log('Form data being sent:');
            for (let [key, value] of formData.entries()) {
              console.log(key, value);
            }

            // KHÔNG tự tạo Id, để server tạo
            // if (!formData.get('Id')) {
            //   formData.append('Id', generateObjectId());
            // }

            fetch('/admin/product/create', {
              method: 'POST',
              body: formData,
            })
            .then(response => {
              const contentType = response.headers.get('content-type') || '';

              console.log('Response status:', response.status);
              console.log('Response content-type:', contentType);

              if (!response.ok) {
                if (contentType.includes('application/json')) {
                  return response.json().then(err => {
                    console.error('Server error (JSON):', err);
                    return Promise.reject(err);
                  });
                } else {
                  return response.text().then(text => {
                    console.error('Server error (Text):', text);
                    return Promise.reject({ message: text || 'Lỗi server' });
                  });
                }
              }

              if (response.status === 204) {
                return null;
              }

              if (contentType.includes('application/json')) {
                return response.json();
              } else {
                return response.text();
              }
            })
            .then(data => {
              console.log('Success response:', data);

              if (!data) {
                alert('Không có dữ liệu trả về từ server.');
                return;
              }

              if (data.success) {
                alert(data.message);
                form.reset();
                // window.location.href = '/admin/product';
              } else {
                alert(data.message || 'Có lỗi xảy ra');
              }
            })
            .catch(err => {
              console.error('Fetch error:', err);

              if (err.errors) {
                let errorMessages = [];
                for (const field in err.errors) {
                  errorMessages.push(field + ": " + err.errors[field].join(", "));
                }
                alert("Lỗi dữ liệu:\n" + errorMessages.join("\n"));
              } else {
                alert(err.message || 'Có lỗi hệ thống. Vui lòng thử lại.');
              }
            });
          });
        });
    </script>
}
