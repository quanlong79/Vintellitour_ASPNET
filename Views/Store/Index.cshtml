<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cửa hàng VintelliTour</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="~/css/toast.css" />
</head>
<div id="toast-container" style="position: fixed; top: 20px; right: 20px; z-index: 9999;"></div>
<body class="bg-gray-50">
    <!-- Header Hero -->
    <section class="bg-gradient-to-r from-blue-600 to-blue-800 text-white py-16">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
            <h1 class="text-5xl font-bold mb-4">Chào mừng đến với cửa hàng VintelliTour</h1>
            <p class="text-xl mb-8 text-blue-100">
                Khám phá và mua sắm những sản phẩm du lịch, thiết bị trải nghiệm AI, quà lưu niệm thông minh và nhiều hơn nữa.
            </p>

            <!-- Search Bar -->
            <div class="max-w-2xl mx-auto relative">
                <input type="text" 
                       id="searchInput"
                       placeholder="Tìm kiếm sản phẩm..."
                       class="pl-12 pr-4 py-4 w-full text-gray-900 rounded-xl shadow-lg focus:ring-2 focus:ring-blue-300 border-0" />
                <i class="fas fa-search absolute left-4 top-1/2 transform -translate-y-1/2 text-gray-400 text-lg"></i>
            </div>
        </div>
    </section>

    <!-- Main Content -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <div class="flex flex-col lg:flex-row gap-8">

            <!-- Sidebar Filters -->
            <aside class="lg:w-64 space-y-6">
                <div class="bg-white rounded-xl shadow-md p-6">
                    <h3 class="font-bold text-lg mb-4 text-gray-800">Danh mục</h3>
                    <div class="space-y-3 text-sm" id="categoryFilters">
                        <label class="flex items-center hover:bg-gray-50 p-2 rounded-lg cursor-pointer">
                            <input type="radio" name="category" value="" class="mr-2" checked />
                            <span>Tất cả</span>
                        </label>
                        <label class="flex items-center hover:bg-gray-50 p-2 rounded-lg cursor-pointer">
                            <input type="radio" name="category" value="Bản đồ" class="mr-2" />
                            <span>Bản đồ</span>
                        </label>
                        <label class="flex items-center hover:bg-gray-50 p-2 rounded-lg cursor-pointer">
                            <input type="radio" name="category" value="Ba lô" class="mr-2" />
                            <span>Ba lô</span>
                        </label>
                        <label class="flex items-center hover:bg-gray-50 p-2 rounded-lg cursor-pointer">
                            <input type="radio" name="category" value="Phụ kiện" class="mr-2" />
                            <span>Phụ kiện</span>
                        </label>
                        <label class="flex items-center hover:bg-gray-50 p-2 rounded-lg cursor-pointer">
                            <input type="radio" name="category" value="Điện tử" class="mr-2" />
                            <span>Điện tử</span>
                        </label>
                    </div>
                </div>

                <div class="bg-white rounded-xl shadow-md p-6">
                    <h3 class="font-bold text-lg mb-4 text-gray-800">Khoảng giá</h3>
                    <input type="range"
                           id="priceSlider"
                           min="0"
                           max="2000000"
                           step="50000"
                           value="2000000"
                           class="w-full mb-2 accent-blue-600" />
                    <div class="flex justify-center text-sm text-gray-700">
                        <span class="bg-gray-100 px-4 py-1 rounded-lg font-medium" id="priceValue">
                            2.000.000 ₫
                        </span>
                    </div>
                </div>
            </aside>

            <!-- Product Listing -->
            <main class="flex-1">
                <!-- Loading indicator -->
                <div id="loadingIndicator" class="hidden text-center py-8">
                    <div class="inline-block animate-spin rounded-full h-8 w-8 border-b-2 border-blue-600"></div>
                    <p class="mt-2 text-gray-600">Đang tải...</p>
                </div>

                <!-- Toolbar -->
                <div class="bg-white rounded-xl shadow-md p-6 mb-8">
                    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
                        <div>
                            <h2 class="text-xl font-bold text-gray-800">Sản phẩm</h2>
                            <span class="text-gray-600" id="productCount">Hiển thị 12 sản phẩm</span>
                        </div>
                        <div class="flex items-center space-x-4">
                            <select id="sortSelect" class="border border-gray-300 px-4 py-2 rounded-lg text-sm focus:ring-2 focus:ring-blue-500">
                                <option value="featured">Nổi bật</option>
                                <option value="newest">Mới nhất</option>
                                <option value="price_asc">Giá thấp đến cao</option>
                                <option value="price_desc">Giá cao đến thấp</option>
                                <option value="rating">Đánh giá cao nhất</option>
                            </select>

                            <!-- View Toggle Buttons -->
                            <div class="flex bg-gray-100 rounded-lg">
                                <button id="gridViewBtn" class="p-2 bg-blue-500 text-white rounded-l-lg transition-colors duration-200">
                                    <i class="fas fa-th"></i>
                                </button>
                                <button id="listViewBtn" class="p-2 bg-gray-100 text-gray-700 rounded-r-lg hover:bg-gray-200 transition-colors duration-200">
                                    <i class="fas fa-list"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Product Container -->
                <div id="productContainer">
                    <!-- Products will be loaded here -->
                </div>

                <!-- No results -->
                <div id="noResults" class="hidden text-center py-16">
                    <div class="bg-gray-100 rounded-full w-20 h-20 flex items-center justify-center mx-auto mb-4">
                        <i class="fas fa-search text-3xl text-gray-400"></i>
                    </div>
                    <p class="text-gray-500 text-lg mb-4">Không tìm thấy sản phẩm nào phù hợp.</p>
                    <button id="clearFiltersBtn" class="bg-blue-600 text-white px-6 py-2 rounded-lg hover:bg-blue-700 transition">
                        Xóa bộ lọc
                    </button>
                </div>
            </main>
        </div>
    </div>

    <!-- Modal: Thêm vào giỏ hàng nhanh - giao diện mới -->
    <div id="addToCartModal" class="fixed inset-0 bg-black bg-opacity-40 z-50 hidden flex items-center justify-center">
        <div id="modalContent" class="bg-white rounded-xl p-6 w-full max-w-xl relative shadow-xl transform scale-95 opacity-0 transition-all duration-300">
            <button class="absolute top-4 right-4 text-gray-500 hover:text-red-500 text-xl" id="closeModalBtn">&times;</button>

            <div class="flex flex-col md:flex-row gap-6">
                <img id="modalProductImage" src="" class="w-full md:w-1/2 h-60 object-cover rounded-lg border" />

                <div class="flex-1">
                    <h2 id="modalProductName" class="text-2xl font-bold mb-3 text-gray-900"></h2>

                    <div class="flex items-center gap-3 mb-2">
                        <div class="text-blue-600 text-xl font-semibold" id="modalProductPrice"></div>
                        <div class="line-through text-gray-500 text-sm" id="modalProductOriginalPrice"></div>
                        <div class="bg-red-500 text-white text-xs font-bold px-2 py-1 rounded-full" id="modalProductDiscount"></div>
                    </div>

                    <p id="modalProductDescription" class="text-gray-700 mb-4"></p>

                    <label for="modalQuantity" class="block text-sm text-gray-700 mb-1">Số lượng</label>
                    <input type="number" id="modalQuantity" value="1" min="1" class="w-full border px-3 py-2 rounded-lg mb-4" />

                    <div class="flex justify-end gap-4">
                        <button onclick="closeQuickAddModal()" class="bg-gray-200 text-gray-800 px-4 py-2 rounded hover:bg-gray-300">
                            Đóng
                        </button>
                        <button id="confirmAddToCartBtn" class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700 flex items-center gap-2">
                            <i class="fas fa-cart-plus"></i> Thêm vào giỏ hàng
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal: Chi tiết sản phẩm - giao diện mới -->
    <div id="productDetailModal" class="fixed inset-0 bg-black bg-opacity-40 z-50 hidden flex items-center justify-center">
        <div class="bg-white rounded-2xl p-6 w-full max-w-2xl relative shadow-2xl animate__animated animate__fadeInDown">
            <button onclick="closeProductDetailModal()" class="absolute top-4 right-4 text-gray-400 hover:text-red-500 text-2xl">&times;</button>

            <div class="flex flex-col md:flex-row gap-6">
                <div class="flex-shrink-0 w-full md:w-1/2">
                    <div class="w-full h-60 bg-gray-100 rounded-xl border overflow-hidden">
                        <img id="detailModalImage" src="" class="w-full h-full object-cover" alt="Product Image" />
                    </div>
                </div>

                <div class="flex-1 flex flex-col justify-between">
                    <div>
                        <h2 id="detailModalName" class="text-2xl font-bold text-gray-900 mb-2"></h2>

                        <div class="flex items-center text-yellow-400 text-sm gap-1 mb-1" id="detailModalRatingContainer"></div>
                        <p class="text-sm text-gray-500 mb-4" id="detailModalReviewCount"></p>

                        <div class="flex items-center gap-3 mb-3">
                            <div class="text-blue-600 text-2xl font-bold" id="detailModalPrice"></div>
                            <div class="line-through text-gray-400 text-sm" id="detailModalOriginalPrice"></div>
                            <div class="bg-red-500 text-white text-xs font-semibold px-2 py-1 rounded-full" id="detailModalDiscount"></div>
                        </div>

                        <p id="detailModalDescription" class="text-gray-700 text-sm mb-2"></p>
                        <p id="detailModalDetails" class="text-xs text-gray-500 mb-4 leading-relaxed"></p>

                        <label for="detailModalQuantity" class="block text-sm font-medium text-gray-700 mb-1">Số lượng</label>
                        <div class="flex items-center gap-2 mb-4">
                            <button onclick="decrementQuantity()" class="w-8 h-8 rounded-full bg-gray-200 hover:bg-gray-300 text-lg font-bold transition transform active:scale-90">-</button>
                            <input type="number" id="detailModalQuantity" value="1" min="1" class="w-14 text-center border border-gray-300 rounded px-2 py-1 focus:ring-2 focus:ring-blue-500 focus:outline-none" oninput="validateQuantity(this)" />
                            <button onclick="incrementQuantity()" class="w-8 h-8 rounded-full bg-gray-200 hover:bg-gray-300 text-lg font-bold transition transform active:scale-90">+</button>
                        </div>
                    </div>

                    <div class="flex justify-end gap-3 mt-6">
                        <button onclick="addToCartFromDetail()" class="flex items-center justify-center gap-2 bg-blue-600 hover:bg-blue-700 text-white font-medium px-5 py-2.5 rounded-lg shadow-md transition duration-150">
                            <i class="fas fa-cart-plus"></i> Thêm vào giỏ
                        </button>
                        <button onclick="closeProductDetailModal()" class="bg-gray-100 hover:bg-gray-200 text-gray-700 font-medium px-5 py-2.5 rounded-lg transition duration-150">
                            Đóng
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>


    <script>
        // API Configuration - Cập nhật URL theo project của bạn
        const API_BASE_URL = '/Store'; // Thay đổi theo controller của bạn

        const isLoggedIn = @((ViewBag.IsLoggedIn ?? false).ToString().ToLower());

        console.log("✅ isLoggedIn:", isLoggedIn, typeof isLoggedIn);

        // Global variables
        let currentFilters = {
            category: '',
            maxPrice: 2000000,
            search: '',
            sort: 'featured'
        };
        let currentViewMode = 'grid';

        // Initialize page
        document.addEventListener('DOMContentLoaded', function() {
            loadProducts();
            setupEventListeners();
            
            // Load saved view mode
            const savedViewMode = localStorage.getItem('productViewMode');
            if (savedViewMode === 'list') {
                showListView();
            } else {
                showGridView();
            }
        });

        function setupEventListeners() {
            // Category filters
            document.querySelectorAll('input[name="category"]').forEach(radio => {
                radio.addEventListener('change', function() {
                    currentFilters.category = this.value;
                    loadProducts();
                });
            });

            // Price slider
            document.getElementById('priceSlider').addEventListener('input', function() {
                const value = parseInt(this.value);
                updatePriceDisplay(value);
                
                clearTimeout(window.priceTimer);
                window.priceTimer = setTimeout(() => {
                    currentFilters.maxPrice = value;
                    loadProducts();
                }, 300);
            });

            // Search input
            document.getElementById('searchInput').addEventListener('input', function() {
                clearTimeout(window.searchTimer);
                window.searchTimer = setTimeout(() => {
                    currentFilters.search = this.value.toLowerCase();
                    loadProducts();
                }, 300);
            });

            // Sort select
            document.getElementById('sortSelect').addEventListener('change', function() {
                currentFilters.sort = this.value;
                loadProducts();
            });

            // View toggle buttons
            document.getElementById('gridViewBtn').addEventListener('click', showGridView);
            document.getElementById('listViewBtn').addEventListener('click', showListView);

            // Clear filters button
            document.getElementById('clearFiltersBtn').addEventListener('click', clearAllFilters);
        }

        function updatePriceDisplay(value) {
            const formattedPrice = new Intl.NumberFormat('vi-VN').format(value) + ' ₫';
            document.getElementById('priceValue').textContent = formattedPrice;
        }

        async function loadProducts() {
            showLoading(true);
            
            try {
                // Tạo query parameters
                const params = new URLSearchParams({
                    category: currentFilters.category || '',
                    maxPrice: currentFilters.maxPrice,
                    search: currentFilters.search || '',
                    sort: currentFilters.sort
                });

                // Gọi API đến ASP.NET MVC Controller
                const response = await fetch(`${API_BASE_URL}/GetProducts?${params.toString()}`, {
                    method: 'GET',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-Requested-With': 'XMLHttpRequest' // Để ASP.NET MVC nhận biết AJAX request
                    }
                });

                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }

                const data = await response.json();
                
                // Kiểm tra cấu trúc response
                const products = Array.isArray(data) ? data : (data.products || []);
                
                renderProducts(products);
                updateProductCount(products.length);
                
            } catch (error) {
                console.error('Lỗi khi tải sản phẩm:', error);
                showError('Có lỗi xảy ra khi tải sản phẩm. Vui lòng thử lại.');
            } finally {
                showLoading(false);
            }
        }

        // Hàm hiển thị lỗi
        function showError(message) {
            const container = document.getElementById('productContainer');
            container.innerHTML = `
                <div class="text-center py-16">
                    <div class="bg-red-100 rounded-full w-20 h-20 flex items-center justify-center mx-auto mb-4">
                        <i class="fas fa-exclamation-triangle text-3xl text-red-500"></i>
                    </div>
                    <p class="text-red-500 text-lg mb-4">${message}</p>
                    <button onclick="loadProducts()" class="bg-blue-600 text-white px-6 py-2 rounded-lg hover:bg-blue-700 transition">
                        Thử lại
                    </button>
                </div>
            `;
        }

        function renderProducts(products) {
            const container = document.getElementById('productContainer');
            const noResults = document.getElementById('noResults');
            
            if (products.length === 0) {
                container.innerHTML = '';
                noResults.classList.remove('hidden');
                return;
            }
            
            noResults.classList.add('hidden');
            
            if (currentViewMode === 'grid') {
                container.innerHTML = `<div id="gridView" class="grid gap-6 grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">${renderGridProducts(products)}</div>`;
            } else {
                container.innerHTML = `<div id="listView" class="space-y-4">${renderListProducts(products)}</div>`;
            }
        }

        function renderGridProducts(products) {
            return products.map(product => {
                const discountPercent = product.originalPrice > product.price
                    ? Math.round((1 - (product.price / product.originalPrice)) * 100)
                    : 0;
                return `
                    <div class="bg-white rounded-xl shadow-md hover:shadow-lg transition duration-300 overflow-hidden group flex flex-col h-[430px]">
                        <!-- Hình ảnh -->
                        <div class="relative flex-shrink-0">
                            <div class="h-48 bg-gray-100 flex items-center justify-center overflow-hidden">
                                <img src="${product.image}" alt="${product.name}" class="object-contain max-h-full max-w-full" />
                            </div>
                            <div class="absolute top-3 left-3 flex flex-col gap-2">
                                ${product.isNew ? '<span class="bg-green-500 text-white text-xs font-bold px-3 py-1 rounded-full">Mới</span>' : ''}
                                ${product.isBestSeller ? '<span class="bg-orange-500 text-white text-xs font-bold px-3 py-1 rounded-full">Bán chạy</span>' : ''}
                            </div>
                            ${discountPercent > 0 ? `<span class="bg-red-500 text-white text-xs font-bold px-3 py-1 rounded-full absolute top-3 right-3">-${discountPercent}%</span>` : ''}
                        </div>

                        <!-- Nội dung -->
                        <div class="p-5 flex flex-col flex-1 min-h-0">
                            <!-- Tên sản phẩm -->
                            <div class="flex-shrink-0 mb-3">
                                <h3 class="font-bold text-lg text-gray-800 group-hover:text-blue-600 transition duration-200 line-clamp-2 leading-tight min-h-[3.5rem]">${product.name}</h3>
                            </div>

                            <!-- Đánh giá -->
                            <div class="flex-shrink-0 mb-3">
                                <div class="flex items-center text-yellow-400">
                                    ${renderStars(product.rating)}
                                    <span class="text-sm text-gray-600 ml-2">(${product.reviews})</span>
                                </div>
                            </div>

                            <!-- Giá -->
                            <div class="flex-shrink-0 mb-4">
                                <div class="flex items-baseline gap-2">
                                    <span class="text-lg font-bold text-blue-600">${formatPrice(product.price)}</span>
                                    ${discountPercent > 0 ? `<span class="text-sm line-through text-gray-500">${formatPrice(product.originalPrice)}</span>` : ''}
                                </div>
                            </div>

                            <!-- Nút xem chi tiết -->
                            <div class="flex-shrink-0 mt-auto">
                                <button
                                    class="view-detail-btn bg-blue-600 text-white px-4 py-2 rounded-lg w-full hover:bg-blue-700 transition font-medium flex items-center justify-center space-x-2"
                                    data-product-id="${product.id}">
                                    <i class="fas fa-eye"></i>
                                    <span>Xem chi tiết</span>
                                </button>
                            </div>
                        </div>
                    </div>
                `;
            }).join('');
        }

        function renderListProducts(products) {
            return products.map(product => {
                const discountPercent = product.originalPrice > product.price
                    ? Math.round((1 - (product.price / product.originalPrice)) * 100)
                    : 0;

                return `
                    <div class="bg-white rounded-xl shadow-md hover:shadow-lg transition duration-300 overflow-hidden">
                        <div class="flex flex-col sm:flex-row">
                            <div class="relative sm:w-48 h-48 sm:h-auto">
                                <img src="${product.image}" alt="${product.name}" class="w-full h-full object-cover" />
                                
                                <div class="absolute top-3 left-3 flex flex-col gap-2">
                                    ${product.isNew ? '<span class="bg-green-500 text-white text-xs font-bold px-3 py-1 rounded-full">Mới</span>' : ''}
                                    ${product.isBestSeller ? '<span class="bg-orange-500 text-white text-xs font-bold px-3 py-1 rounded-full">Bán chạy</span>' : ''}
                                </div>
                                
                                ${discountPercent > 0 ? `<span class="bg-red-500 text-white text-xs font-bold px-3 py-1 rounded-full absolute top-3 right-3">-${discountPercent}%</span>` : ''}
                            </div>
                            
                            <div class="flex-1 p-6">
                                <div class="flex flex-col sm:flex-row justify-between h-full">
                                    <div class="flex-1">
                                        <h3 class="font-bold text-xl mb-2 text-gray-800 hover:text-blue-600 transition duration-200">${product.name}</h3>
                                        <p class="text-gray-600 mb-3 text-sm">${product.description}</p>
                                        
                                        <div class="flex items-center text-yellow-400 mb-4">
                                            ${renderStars(product.rating)}
                                            <span class="text-sm text-gray-600 ml-2">(${product.reviews})</span>
                                        </div>
                                    </div>
                                    
                                    <div class="flex flex-col justify-between items-end sm:ml-6">
                                        <div class="text-right mb-4">
                                            <div class="text-2xl font-bold text-blue-600 whitespace-nowrap">${formatPrice(product.price)}</div>
                                            ${discountPercent > 0 ? `<div class="text-sm line-through text-gray-500">${formatPrice(product.originalPrice)}</div>` : ''}
                                        </div>
                                        <button class="view-detail-btn bg-blue-600 text-white px-4 py-3 rounded-lg w-full hover:bg-blue-700 transition duration-200 font-medium flex items-center justify-center space-x-2"
                                                        data-product-id="${product.id}">
                                            <i class="fas fa-eye"></i>
                                            <span>Xem chi tiết</span>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                `;
            }).join('');
        }

        function renderStars(rating) {
            let stars = '';
            for (let i = 0; i < 5; i++) {
                if (i < Math.floor(rating)) {
                    stars += '<i class="fas fa-star mr-1"></i>';
                } else {
                    stars += '<i class="far fa-star text-gray-300 mr-1"></i>';
                }
            }
            return stars;
        }

        function formatPrice(price) {
            return new Intl.NumberFormat('vi-VN').format(price) + ' ₫';
        }

        function showGridView() {
            currentViewMode = 'grid';
            
            const gridBtn = document.getElementById('gridViewBtn');
            const listBtn = document.getElementById('listViewBtn');
            
            gridBtn.classList.add('bg-blue-500', 'text-white');
            gridBtn.classList.remove('bg-gray-100', 'text-gray-700');
            
            listBtn.classList.add('bg-gray-100', 'text-gray-700');
            listBtn.classList.remove('bg-blue-500', 'text-white');
            
            localStorage.setItem('productViewMode', 'grid');
            loadProducts();
        }

        function showListView() {
            currentViewMode = 'list';
            
            const gridBtn = document.getElementById('gridViewBtn');
            const listBtn = document.getElementById('listViewBtn');
            
            listBtn.classList.add('bg-blue-500', 'text-white');
            listBtn.classList.remove('bg-gray-100', 'text-gray-700');
            
            gridBtn.classList.add('bg-gray-100', 'text-gray-700');
            gridBtn.classList.remove('bg-blue-500', 'text-white');
            
            localStorage.setItem('productViewMode', 'list');
            loadProducts();
        }

        function showLoading(show) {
            const loadingIndicator = document.getElementById('loadingIndicator');
            const productContainer = document.getElementById('productContainer');
            
            if (show) {
                loadingIndicator.classList.remove('hidden');
                productContainer.style.opacity = '0.5';
            } else {
                loadingIndicator.classList.add('hidden');
                productContainer.style.opacity = '1';
            }
        }

        function updateProductCount(count) {
            document.getElementById('productCount').textContent = `Hiển thị ${count} sản phẩm`;
        }

        function clearAllFilters() {
            // Reset filters
            currentFilters = {
                category: '',
                maxPrice: 2000000,
                search: '',
                sort: 'featured'
            };
            
            // Reset UI
            document.querySelector('input[name="category"][value=""]').checked = true;
            document.getElementById('priceSlider').value = 2000000;
            updatePriceDisplay(2000000);
            document.getElementById('searchInput').value = '';
            document.getElementById('sortSelect').value = 'featured';
            
            // Reload products
            loadProducts();
        }

        const quickAddModal = document.getElementById('addToCartModal');
        const quickModalContent = document.getElementById('modalContent');
        const quickQuantityInput = document.getElementById('modalQuantity');
        let selectedQuickProductId = null;

        function openQuickAddModal(productId, image, name, price) {
            selectedQuickProductId = productId;
            document.getElementById('modalProductImage').src = image;
            document.getElementById('modalProductName').innerText = name;
            document.getElementById('modalProductPrice').innerText = price;
            quickQuantityInput.value = 1;

            quickAddModal.classList.remove('hidden');
            setTimeout(() => {
                quickModalContent.classList.remove('opacity-0', 'scale-95');
                quickModalContent.classList.add('opacity-100', 'scale-100');
            }, 10);
        }

        function closeQuickAddModal() {
            quickModalContent.classList.remove('opacity-100', 'scale-100');
            quickModalContent.classList.add('opacity-0', 'scale-95');
            setTimeout(() => {
                quickAddModal.classList.add('hidden');
            }, 300);
        }

        document.addEventListener('click', function (e) {
            const btn = e.target.closest('.add-to-cart-btn');
            if (!btn) return;

            const card = btn.closest('.group, .bg-white');
            const image = card.querySelector('img')?.src || '';
            const name = card.querySelector('h3')?.innerText || '';
            const price = card.querySelector('.text-blue-600')?.innerText || '';
            const productId = btn.dataset.productId;

            openQuickAddModal(productId, image, name, price);
        });

        document.getElementById('confirmAddToCartBtn').addEventListener('click', () => {
            

            const quantity = parseInt(quickQuantityInput.value);
            fetch(`/Cart/AddToCart?productId=${selectedQuickProductId}&quantity=${quantity}`, {
                method: 'POST'
            })
                .then(res => res.json())
                .then(data => {
                    showToast(data.success ? '🛒 Đã thêm vào giỏ hàng!' : '❌ Lỗi khi thêm sản phẩm!', data.success ? 'success' : 'error');
                    updateCartItemCount();
                    closeQuickAddModal();
                })
                .catch(err => {
                    console.error('Lỗi fetch:', err);
                    alert('⚠ Không thể kết nối đến máy chủ!');
                });
        });

        document.getElementById('closeModalBtn').addEventListener('click', closeQuickAddModal);

        function openProductDetailModal(productId) {
            fetch(`/Store/GetDetails?id=${productId}`)
                .then(res => res.json())
                .then(product => {
                    document.getElementById("detailModalName").textContent = product.name;
                    document.getElementById("detailModalImage").src = product.image;

                    // Giá & giảm giá
                    document.getElementById("detailModalPrice").textContent =
                        formatPrice(product.price);

                    const originalPrice = product.originalPrice || 0;
                    if (originalPrice > product.price) {
                        document.getElementById("detailModalOriginalPrice").textContent = formatPrice(originalPrice);
                        const discount = Math.round(100 - (product.price / originalPrice) * 100);
                        document.getElementById("detailModalDiscount").textContent = `-${discount}%`;
                    } else {
                        document.getElementById("detailModalOriginalPrice").textContent = '';
                        document.getElementById("detailModalDiscount").textContent = '';
                    }

                    // Mô tả
                    document.getElementById("detailModalDescription").textContent = product.description || '';
                    document.getElementById("detailModalDetails").textContent = product.details || '';

                    // Đánh giá
                    document.getElementById("detailModalRatingContainer").innerHTML = renderStars(product.rating || 0) +
                        `<span class="text-gray-500 text-sm ml-2">(${product.reviews || 0} đánh giá)</span>`;

                    // Hiển thị modal
                    document.getElementById("productDetailModal").classList.remove("hidden");

                    // Lưu ID
                    window.selectedDetailProductId = product.id;
                })
                .catch(err => console.error("❌ Lỗi khi lấy chi tiết sản phẩm:", err));
        }

        function closeProductDetailModal() {
            document.getElementById("productDetailModal").classList.add("hidden");
        }

        function addToCartFromDetail() {   
            if (!isLoggedIn) {
                showToast("Bạn chưa đăng nhập!", "error");
                setTimeout(() => {
                    window.location.href = "/Account/Login";
                }, 1500);
                return;
            }

            const quantity = parseInt(document.getElementById('detailModalQuantity').value) || 1;
            if (!window.selectedDetailProductId) return;

            fetch(`/Cart/AddToCart?productId=${window.selectedDetailProductId}&quantity=${quantity}`, {
                method: 'POST'
            })
                .then(res => res.json())
                .then(data => {
                    showToast(data.success ? '🛒 Đã thêm vào giỏ hàng!' : '❌ Lỗi khi thêm sản phẩm!', data.success ? 'success' : 'error');
                    updateCartItemCount?.();
                    closeProductDetailModal();
                })
                .catch(err => {
                    console.error('Lỗi fetch:', err);
                    alert('⚠ Không thể kết nối đến máy chủ!');
                });
        }

        document.addEventListener('click', function (e) {
            const btn = e.target.closest('.view-detail-btn');
            if (!btn) return;

            const productId = btn.dataset.productId;
            openProductDetailModal(productId);
        });

        function showToast(message, type = 'success') {
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');

            // Đặt class trực tiếp cho toast
            toast.className = 'flex items-center gap-3 px-5 py-3 rounded-xl shadow-md text-white toast-slide-in';

            // Màu nền theo type
            if (type === 'error') {
                toast.classList.add('bg-red-500');
            } else if (type === 'warning') {
                toast.classList.add('bg-yellow-500');
            } else if (type === 'info') {
                toast.classList.add('bg-blue-500');
            } else {
                toast.classList.add('bg-green-500');
            }

            toast.innerHTML = `<span class="text-sm font-medium">${message}</span>`;

            container.appendChild(toast);

            setTimeout(() => {
                toast.classList.remove('toast-slide-in');
                toast.classList.add('toast-fade-out');
                toast.addEventListener('animationend', () => toast.remove());
            }, 2500);
        }



        function incrementQuantity() {
          const input = document.getElementById('detailModalQuantity');
          input.value = Math.max(1, parseInt(input.value) + 1);
          animateInput(input);
        }

        function decrementQuantity() {
          const input = document.getElementById('detailModalQuantity');
          if (parseInt(input.value) > 1) {
            input.value = parseInt(input.value) - 1;
            animateInput(input);
          }
        }

        function validateQuantity(input) {
          if (!input.value || parseInt(input.value) < 1) {
            input.value = 1;
          }
        }

        function animateInput(input) {
          input.classList.add('ring-2', 'ring-blue-300');
          setTimeout(() => {
            input.classList.remove('ring-2', 'ring-blue-300');
          }, 200);
        }
    </script>

</body>
</html>